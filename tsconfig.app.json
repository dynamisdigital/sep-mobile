/* TypeScript config para a build da aplicacao Ionic/Angular. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "src/test-polyfills.ts",
    "src/mocks/server.ts"
  ]
}
